# ---- Supabase (backend: auth + database + realtime) ----
# Get these from your Supabase project: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Never expose to the browser.
# Dashboard > Project Settings > API > service_role (requires SB Admin access)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe (subscriptions) ----
# Dashboard > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Dashboard > Developers > Webhooks > endpoint secret (for /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for each plan tier — created in Stripe as recurring subscription prices.
# Dashboard > Products & Prices
STRIPE_PRICE_FREE=
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Base URL used for checkout redirects (e.g. localhost dev or your deployed origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000